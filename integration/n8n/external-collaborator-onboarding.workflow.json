      "parameters": {
        "jsCode": "// Verify IAM-Signature = HMAC_SHA256(rawBody, signingKey). Set SIGNING_KEY in n8n (or a credential).\nconst crypto = require('crypto');\nconst raw = $input.first().json.body ? JSON.stringify($input.first().json.body) : $input.first().binary;\nconst rawBody = $('Webhook (onboarded)').first().json.rawBody || JSON.stringify($json);\nconst sig = $('Webhook (onboarded)').first().headers['iam-signature'] || '';\nconst key = $env.IAM_LIFECYCLE_SIGNING_KEY || '';\nif (key) {\n  const want = crypto.createHmac('sha256', key).update(rawBody, 'utf8').digest('hex');\n  if (want !== sig) { throw new Error('bad IAM-Signature'); }\n}\nreturn $input.all();"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://erp.devandre.sbs/api/resource/Employee",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "token {{ $env.ERPNEXT_API_KEY }}:{{ $env.ERPNEXT_API_SECRET }}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"first_name\": \"{{ $json.body.displayName }}\", \"employment_type\": \"{{ $json.body.engagementType }}\", \"custom_agency_or_firm\": \"{{ $json.body.firm }}\", \"contract_end_date\": \"{{ $json.body.endDate }}\", \"status\": \"Active\", \"custom_iam_collaborator_id\": \"{{ $json.body.idempotencyKey }}\" }",
        "options": {}
      },
      "name": "ERPNext upsert Employee (non-payroll)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://iam.10.0.0.200.nip.io/api/collaborators/{{ $('Webhook (onboarded)').first().json.body.collaboratorId }}/hr-worker-ref",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "X-IAM-Service-Key", "value": "={{ $env.IAM_SERVICE_KEY }}" } ] },
        "sendBody": true,
