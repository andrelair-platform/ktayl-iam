# ktayl-iam backend — environment (in-cluster these come from ESO→Vault, never Git)

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Session (cookie signing) — a long random string
SESSION_SECRET=change-me

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ktayl_iam
DATABASE_PASSWORD=change-me
DATABASE_NAME=ktayl_iam

# Authentik OIDC (admin-only login). Endpoint URLs come from the Authentik provider.
AUTHENTIK_ISSUER=https://auth.devandre.sbs/application/o/ktayl-iam/
AUTHENTIK_AUTH_URL=https://auth.devandre.sbs/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://auth.devandre.sbs/application/o/token/
AUTHENTIK_USERINFO_URL=https://auth.devandre.sbs/application/o/userinfo/
AUTHENTIK_CLIENT_ID=change-me
AUTHENTIK_CLIENT_SECRET=change-me
AUTHENTIK_CALLBACK_URL=https://iam.10.0.0.200.nip.io/api/auth/callback
AUTHENTIK_SCOPE=openid profile email groups
# Only members of this Authentik group may use the console:
ADMIN_GROUP=ktayl-admin
